# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto no Supabase
# (Supabase > Project Settings > API). Sem eles, o painel roda em modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (ou, nos projetos novos: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=)

# Opcional: endereço secreto iCal do Google Agenda (só no servidor, nunca começa com NEXT_PUBLIC_)
GOOGLE_AGENDA_ICAL_URL=
